# Most GlobeView layers need no credentials. These regional traffic feeds require keys:
# AMERICAMAP_TDOT_API_KEY=<your_tdot_smartway_key>
# AMERICAMAP_GOKY_API_KEY=<your_goky_firestore_key>

# Optional worldwide live vessel positions. Keep this key on the server.
# AISSTREAM_API_KEY=<your_aisstream_key>
# AISSTREAM_MAX_BOXES=32
# AISSTREAM_MAX_VIEWERS=512

# Optional server settings
# AMERICAMAP_HOST=127.0.0.1
# AMERICAMAP_PORT=8765
# AMERICAMAP_DEBUG=0
# AMERICAMAP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# AMERICAMAP_TRUSTED_PROXIES=127.0.0.1,::1

# Capacity controls. When the request ceiling is full, new requests receive a
# short 503/Retry-After response instead of exhausting the VM.
# AMERICAMAP_MAX_REQUESTS=128
# AMERICAMAP_REQUEST_QUEUE=256
# AMERICAMAP_IDLE_TIMEOUT=20
# AMERICAMAP_MAX_STREAMS=48
# AMERICAMAP_API_UPSTREAM_CONCURRENCY=16
# AMERICAMAP_MEDIA_UPSTREAM_CONCURRENCY=32
# AMERICAMAP_SOURCE_FETCH_WORKERS=16

# Shared server cache. JSON traffic responses persist across restarts; media
# tiles and camera snapshots stay in bounded memory only.
# AMERICAMAP_CACHE_ENABLED=1
# AMERICAMAP_CACHE_DIR=/var/cache/globeview
# AMERICAMAP_CACHE_MAX_ENTRIES=4096
# AMERICAMAP_CACHE_MAX_BYTES=268435456
# AMERICAMAP_MEDIA_CACHE_MAX_ENTRIES=2048
# AMERICAMAP_MEDIA_CACHE_MAX_BYTES=100663296
# AMERICAMAP_CACHE_REFRESH_WORKERS=12
# AMERICAMAP_GZIP_CACHE_MAX_ENTRIES=256
# AMERICAMAP_GZIP_CACHE_MAX_BYTES=67108864
# AMERICAMAP_TRAFFIC_STALE_TTL=21600
# AMERICAMAP_TOOLTIP_STALE_TTL=21600
# AMERICAMAP_SNAPSHOT_CACHE_TTL=8
# AMERICAMAP_TILE_CACHE_TTL=60
# AMERICAMAP_RADAR_TILE_CACHE_TTL=120
# AMERICAMAP_RADAR_TILE_STALE_TTL=600

# Optional upstream overrides for future state adapters:
# PULSEPOINT_SECRET=<override_the_public_web_client_value>
